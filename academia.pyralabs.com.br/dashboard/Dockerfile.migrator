FROM node:20-alpine

WORKDIR /app

# Instala deps completas (precisa do prisma CLI que está em devDependencies)
COPY package*.json ./
RUN npm ci --legacy-peer-deps

# Schema, migrations e config do Prisma
COPY prisma ./prisma
COPY prisma.config.ts ./

# Aplica só as migrations pendentes (registradas em _prisma_migrations).
# Antes era `prisma db push`, que sincronizava o schema direto no banco de produção.
# Baseline feita em 2026-11-15: prisma/migrations/00000000000000_baseline.
# Se falhar, o deploy.sh para antes de subir o web (set -e + compose wait).
CMD ["npx", "prisma", "migrate", "deploy"]
